--- !u!114 &46953198
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 46953193}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec27c5c2bff09c24da010651170e69c7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - speaker: "\uC5EC\uC790\uC560"
    text: "\uC548\uB155! \uB9C8\uC744 \uC18C\uAC1C\uB97C \uD574\uC904\uAC8C."
  - speaker: "\uB098"
    text: "\uACE0\uB9C8\uC6CC"
  - speaker: "\uC5EC\uC790\uC560"
    text: "\uC5EC\uAE30 \uBC14\uB85C \uC704\uC5D0\uB294 \uC6B0\uB9AC\uC9D1\uC774\uC57C!
      \uC5B8\uC81C\uB4E0 \uB180\uB7EC\uC640"
  - speaker: "\uC5EC\uC790\uC560"
    text: "\uADF8\uB9AC\uAD6C \uC624\uB978\uCABD \uC704\uB85C \uAC00\uBA74 \uCD0C\uC7A5\uB2D8\uC758
      \uC9D1\uC774 \uC788\uC5B4. \n\uC544 \uADFC\uB370 \uAC00\uBA74 \uC548\uB418\uB294\uACF3\uC774
      \uC788\uC5B4."
  - speaker: "\uB098"
    text: "\uC5B4\uB518\uB370??"
  - speaker: "\uC5EC\uC790\uC560"
    text: "\uC544\uB798 \uC0AC\uB2E4\uB9AC\uB97C \uD0C0\uACE0 \uB4E4\uC5B4\uAC00\uBA74
      \uBB34\uAE30\uCC3D\uACE0\uAC00 \uB098\uC640. \uAC70\uAE34 \uB4E4\uC5B4\uAC00\uBA74
      \uC548\uB3FC!!"
  prompt: {fileID: 562868070}
  dialogueBox: {fileID: 515966065}
